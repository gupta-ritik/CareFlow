# CareFlow .gitignore
# Never commit secrets, local databases, patient data or build output.

# ---- Secrets and environment ---------------------------------------------------------------
# Real settings: JWT secret, Groq key, Neon connection strings. Commit only the *.example files.
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
*.crt
secrets/

# Neon CLI link to your cloud project (created by `neon init` / `neon env pull`)
.neon

# ---- Data: never commit databases, backups or exports (they can hold patient data) ----------
backups/
*.db
*.sqlite
*.sqlite3
*.sql
*.sql.gz
*.dump
careflow-*.csv
pgdata/
redis-data/
*.rdb
*.aof
appendonlydir/

# ---- Python (backend) ------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.ipynb_checkpoints/
.cache/
dist/
build/
evals/results.json

# ---- Node / Next.js (web) --------------------------------------------------------------------
node_modules/
.next/
out/
coverage/
.eslintcache
*.tsbuildinfo
next-env.d.ts
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Documentation site build output (mkdocs build) ------------------------------------------
site/
CareFlow-Documentation.pdf

# ---- Hosting tools ---------------------------------------------------------------------------
.render/

# ---- Logs and temporary files ----------------------------------------------------------------
*.log
logs/
tmp/
*.tmp
*.bak
*.orig
*.swo

# ---- Editors and operating systems -----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- Claude Code: personal settings stay local (shared skills in .claude/skills are committed)
.claude/settings.local.json
