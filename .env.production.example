# Production settings for docker-compose.prod.yml. Copy to .env.production and fill in every value.
# Generate secrets with:  openssl rand -hex 32   (or: python -c "import secrets; print(secrets.token_hex(32))")
# Never commit .env.production.

# --- required -------------------------------------------------------------------------------------
CAREFLOW_DOMAIN=careflow.your-hospital.in       # DNS must point at this server
ACME_EMAIL=it@your-hospital.in                  # Let's Encrypt expiry notices
CAREFLOW_JWT_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- database on Neon (optional) -------------------------------------------------------------------
# Pooled connection string from `neon connection-string production --pooled`. Leave empty to use the bundled postgres.
DATABASE_URL=

# --- AI agents (optional; free tier at console.groq.com). Without a key the rule-based fallback runs. -------
CAREFLOW_GROQ_API_KEY=

# --- session and login policy ---------------------------------------------------------------------
CAREFLOW_JWT_TTL_MINUTES=480                    # one shift
CAREFLOW_LOGIN_MAX_FAILURES=5
CAREFLOW_LOGIN_LOCKOUT_MINUTES=15

# --- department time limits (minutes) -------------------------------------------------------------
CAREFLOW_SLA_PHARMACY=60
CAREFLOW_SLA_DOCUMENTATION=45
CAREFLOW_SLA_INSURANCE=90
CAREFLOW_SLA_BILLING=45
CAREFLOW_SLA_LABORATORY=60

# --- hospital system integrations (docs/integrations.md) ------------------------------------------
CAREFLOW_HL7_BIND=127.0.0.1                     # set to 0.0.0.0 to accept MLLP from the network (firewall it!)
CAREFLOW_HL7_ALLOWED_HOSTS=[]                   # e.g. ["10.0.4.20"] - your interface engine's address
CAREFLOW_HL7_TENANT=
CAREFLOW_HL7_OUTBOUND_HOST=                     # HIS MLLP listener for ADT^A03 on discharge
CAREFLOW_HL7_OUTBOUND_PORT=2575
CAREFLOW_HIS_WEBHOOK_URL=
CAREFLOW_TPA_WEBHOOK_URL=
CAREFLOW_PHARMACY_WEBHOOK_URL=
CAREFLOW_LIS_WEBHOOK_URL=
CAREFLOW_OUTBOUND_SECRET=                       # HMAC key receivers use to verify X-CareFlow-Signature

# --- optional ----------------------------------------------------------------------------------------
CAREFLOW_FHIR_BASE_URL=
CAREFLOW_FHIR_TOKEN=
CAREFLOW_OIDC_JWKS_URL=                         # Keycloak (free) realm JWKS URL for single sign-on
CAREFLOW_OIDC_AUDIENCE=
CAREFLOW_BACKUP_KEEP_DAYS=14
CAREFLOW_BACKUP_HOUR=2
