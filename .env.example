# Copy to .env. Every variable is optional for local development.
# Database: leave unset to use the local PostgreSQL container. For Neon, `neon env pull` adds DATABASE_URL
# (pooled) and DATABASE_URL_UNPOOLED here; CareFlow uses them automatically. CAREFLOW_DATABASE_URL overrides both.
CAREFLOW_GROQ_API_KEY=            # enables the LLM path; without it agents run their deterministic fallback
CAREFLOW_JWT_SECRET=              # required outside dev: 32+ random characters
CAREFLOW_GROQ_MODEL_SMALL=openai/gpt-oss-20b
CAREFLOW_GROQ_MODEL_LARGE=openai/gpt-oss-120b
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=      # e.g. http://otel-collector:4318
